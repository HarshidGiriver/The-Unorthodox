# Kintsugi prototype: sample contacts, no production credentials.
BANK_NAME=Kintsugi Demo Bank
BANK_GRIEVANCE_OFFICER_NAME=Demo Support
BANK_GRIEVANCE_OFFICER_EMAIL=support@example.invalid
BANK_GRIEVANCE_OFFICER_PHONE=Not configured
# KINTSUGI_DB_PATH=C:/path/to/app.sqlite3
# ISOLATION_FOREST_MODEL_PATH=C:/path/to/isolation_forest.joblib
# SCALER_MODEL_PATH=C:/path/to/scaler.joblib
DELIVERY_MODE=simulate
CONTACT_TIMEZONE=Asia/Kolkata
RBI_CALL_HOURS_START=08:00
RBI_CALL_HOURS_END=19:00
